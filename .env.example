# SmartFlow credentials — copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is git-ignored and must never be committed. Nothing in the project reads a
# hardcoded credential; everything goes through python-dotenv and these variable names
# (see src/week7_config.py).
#
# Every one of these is OPTIONAL. Without them the Week 7 service still runs and still
# answers, using an in-process NetworkX graph and composing answers directly from
# retrieved evidence instead of calling Claude. Filling them in switches the backends
# with no code change — `python src/week7_demo.py` will then report Neo4j and Claude
# in its "which backends actually ran" table.

# ── Neo4j AuraDB Free (Week 7 knowledge graph) ──────────────────────────────
# Create a free instance at https://console.neo4j.io — it hands you these three values
# once, at creation time. The URI looks like neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Optional; AuraDB Free only ever has one database, named neo4j.
NEO4J_DATABASE=neo4j

# ── Claude API (Week 7 answer generation) ───────────────────────────────────
# From https://console.anthropic.com/settings/keys
# Alternatively run `ant auth login`, which stores a profile the SDK picks up without
# any environment variable at all.
ANTHROPIC_API_KEY=

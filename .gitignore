# Precision, not blanket ignoring: generated noise is excluded, but result
# artifacts and trained checkpoints stay in git because they are the portfolio
# evidence for each week's Definition of Done.
#
# NOTE: git does not support trailing comments on a pattern line — "path/  # why"
# is treated as part of the pattern and silently matches nothing. Comments go on
# their own line.

# ── environments ─────────────────────────────────────────────────────────────
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# ── secrets (habit set early; nothing sensitive exists yet) ──────────────────
.env

# ── SUMO scratch ─────────────────────────────────────────────────────────────
*.xml.bak
tripinfo*.xml
trips.trips.xml

# ── IDE / tooling ────────────────────────────────────────────────────────────
.claude/

# ── regenerable training noise ───────────────────────────────────────────────
# raw stdout from training runs (SUMO step spam, hundreds of MB)
outputs/logs/
outputs/tensorboard/
# per-process eval shards; the merged CSVs next to them are the tracked result
outputs/tmp_w3/
outputs/tmp_marl/
# mid-run SB3 checkpoints; the final models/*.zip are kept
outputs/checkpoints/
# throwaway checkpoints written by the online-learning loop
models/_online_scratch_*/
# Chroma's binary index: regenerated in seconds by src/vector_store.py from the
# reports, which are themselves tracked. The graph JSON next to it IS kept, because it
# is small, readable, and the fallback backend loads it directly.
outputs/kg/chroma/
# RLlib optimiser state: ~13 MB per run and needed only to *resume* training. The
# policy weights under learner_group/learner/rl_module/ are kept, and those are what
# eval_marl_corridor.load_multi_rl_module() actually loads.
models/marl_*/learner_group/learner/state.pkl

# ── Week 8 vision dataset ────────────────────────────────────────────────────
# 352 MB of rendered frames and labels. Fully regenerable and deterministic:
# `python src/vision_dataset.py` reproduces it byte-for-byte (classes come from a
# hash of the vehicle id, noise from a fixed seed). The trained weights and the
# evaluation metrics next to it ARE kept - those are the evidence.
outputs/vision/dataset/
# ultralytics keeps a second copy of the final epoch; best.pt is the one that
# gets loaded, and it is committed.
models/yolo/corridor/weights/last.pt
# HuggingFace Trainer scratch; the adapter in models/lora/adapter/ is kept
models/lora/run/

# ultralytics downloads the pretrained base weights into the working directory on
# first use. Third-party, re-downloaded automatically, not project evidence.
yolov8n.pt

# ── deliberately NOT ignored ─────────────────────────────────────────────────
# outputs/*.csv, outputs/*.png, outputs/*.md   — benchmark evidence
# outputs/vision/detector_results.json         — held-out detector metrics
# models/yolo/corridor/best.pt + charts        — trained detector and its curves
# models/lora/adapter/                         — the LoRA adapter (1.2 MB)
# outputs/monitor*/                            — per-episode returns behind the curves
# models/*.zip, models/marl_*/                 — trained policies
